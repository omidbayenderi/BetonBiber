# Admin panel password — SHA-256 hash of your desired password.
# Generate: echo -n "yourpassword" | shasum -a 256
VITE_ADMIN_PASS_HASH=your_sha256_hash_here

# EmailJS — contact form email delivery (https://www.emailjs.com)
# Get these from: EmailJS Dashboard → Email Services / Email Templates / Account
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# Supabase — central storage for contact form requests shown in the admin panel.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_REQUESTS_TABLE=quote_requests
